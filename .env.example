# Atheria configuration template.
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#   cp .env.example .env
#
# Full reference: docs/HANDOVER.md section 7.

ATHERIA_ENVIRONMENT=development
ATHERIA_DEBUG=true
ATHERIA_LOG_FORMAT=console          # console for humans, json for production
ATHERIA_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# SQLite needs no server. Use an ABSOLUTE path: the API runs from the repo root
# and Alembic runs from backend/, so a relative path resolves to two different
# files. Replace /ABSOLUTE/PATH/TO with your checkout location.
ATHERIA_DATABASE_URL=sqlite+aiosqlite:////ABSOLUTE/PATH/TO/ATheria/atheria.db
#
# PostgreSQL (docker compose up -d db):
# ATHERIA_DATABASE_URL=postgresql+asyncpg://atheria:atheria@localhost:5432/atheria

# --- LLM provider ---------------------------------------------------------
ATHERIA_LLM_PROVIDER=bedrock        # bedrock | gemini
ATHERIA_LLM_MAX_TOKENS=2000
ATHERIA_LLM_TEMPERATURE=0.0

# Bedrock. Requires AWS credentials in the environment or ~/.aws/credentials.
# IMPORTANT: must be an inference-profile ID (apac./us./global. prefix).
# Bare IDs such as "amazon.nova-lite-v1:0" are rejected for on-demand use.
# Nova Lite is the cheapest model that reliably honours the triage schema;
# Nova Micro is cheaper but silently drops fields — see docs/HANDOVER.md §10.
ATHERIA_AWS_REGION=ap-south-1
ATHERIA_BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# ATHERIA_BEDROCK_GUARDRAIL_ID=
# ATHERIA_BEDROCK_GUARDRAIL_VERSION=

# Google AI Studio. Set ATHERIA_LLM_PROVIDER=gemini to switch engines.
# Note: generativelanguage.googleapis.com is blocked on some corporate
# networks (TLS-inspecting proxies).
# ATHERIA_GEMINI_API_KEY=
# ATHERIA_GEMINI_MODEL_ID=gemini-2.5-flash

# --- Evidence vault -------------------------------------------------------
# filesystem needs nothing installed; s3 targets self-hosted MinIO.
ATHERIA_EVIDENCE_BACKEND=filesystem
ATHERIA_EVIDENCE_ROOT=./evidence_vault
# ATHERIA_EVIDENCE_BUCKET=atheria-evidence
# ATHERIA_EVIDENCE_ENDPOINT_URL=http://localhost:9000
# ATHERIA_EVIDENCE_ACCESS_KEY=
# ATHERIA_EVIDENCE_SECRET_KEY=

# --- Literature intake ----------------------------------------------------
# PubMed is free without a key; a key raises the rate limit from 3/s to 10/s.
# NCBI asks callers to identify themselves.
# ATHERIA_NCBI_API_KEY=
ATHERIA_NCBI_TOOL_EMAIL=you@example.com

# --- Auth -----------------------------------------------------------------
# WARNING: dev_bypass means NO AUTHENTICATION. Tenancy comes from a
# client-supplied x-tenant-id header and is trivially spoofable.
# Do not expose this build to a network. See docs/HANDOVER.md §14.
ATHERIA_AUTH_MODE=dev_bypass
# ATHERIA_OIDC_ISSUER_URL=
# ATHERIA_OIDC_AUDIENCE=
